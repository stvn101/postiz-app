# CarbonConstruct Postiz deployment - copy to .env next to docker-compose.yaml
# and fill in every value that is empty. Nothing else in the compose file
# needs editing.
#
# Only the three provider families CarbonConstruct posts to are configured:
# LinkedIn (profile + Page), Facebook Page, Instagram. Every other Postiz
# provider stays off simply because its credentials are absent.

# === Public URL (no trailing slash). Caddy obtains the TLS certificate.
POSTIZ_DOMAIN=postiz.carbonconstruct.com.au

# === Secrets you generate
# 64+ random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Postgres password for the Postiz database (any strong string)
POSTIZ_DB_PASSWORD=

# === Registration
# Leave false for the very first start so you can create the admin account,
# then set true and `docker compose up -d` again so nobody else can sign up.
DISABLE_REGISTRATION=false

# === Public API rate limit (requests per hour per API key). The default 30 is
# too tight for the composer + 15-minute sync; 300 leaves headroom.
API_LIMIT=300

# === LinkedIn (https://www.linkedin.com/developers/apps)
# Redirect URLs to register on the app's Auth tab (see SETUP.md):
#   https://${POSTIZ_DOMAIN}/integrations/social/linkedin
#   https://${POSTIZ_DOMAIN}/integrations/social/linkedin-page
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# === Meta app for Facebook Page + Instagram via Facebook Business
#     (https://developers.facebook.com/apps)
# Valid OAuth Redirect URIs (Facebook Login for Business > Settings):
#   https://${POSTIZ_DOMAIN}/integrations/social/facebook
#   https://${POSTIZ_DOMAIN}/integrations/social/instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# === Instagram "API with Instagram Login" (standalone, no Facebook Page)
# Optional - only if the Instagram account is NOT linked to a Facebook Page.
# Redirect URI: https://${POSTIZ_DOMAIN}/integrations/social/instagram-standalone
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# === Optional: OpenAI key enables Postiz' AI assistant in the editor
OPENAI_API_KEY=
